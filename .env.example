# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE"

# Auth
SESSION_SECRET="replace-with-production-secret"

# Environment
NODE_ENV="development"

# ─── AI / OpenRouter (server-side only; never exposed to clients) ───
# The platform owner sets these in the hosting environment (e.g. Netlify
# environment variables). The AI provider/model can also be overridden at
# runtime from Platform -> Billing -> Configuration IA (stored in DB),
# but the API key comes ONLY from the AI_API_KEY env var below.
#
# IMPORTANT: the auth key is AI_API_KEY — NOT OPENROUTER_API_KEY.
# OpenRouter's own client examples use OPENROUTER_API_KEY, but this app
# reads AI_API_KEY. If you set OPENROUTER_API_KEY it will be ignored and
# the UI will report "Clé API : non configurée".
AI_API_KEY="sk-or-..."            # REQUIRED to enable AI calls
AI_PROVIDER_NAME="openrouter"     # provider adapter key (default: openrouter)
AI_MODEL_ID="openrouter/auto"     # routed model (default: openrouter/auto)
AI_MODEL_DISPLAY_NAME="Default AI Model"
AI_BASE_URL="https://openrouter.ai/api/v1/chat/completions" # optional; defaults to OpenRouter

# Public app URL (used as HTTP-Referer when calling OpenRouter)
NEXT_PUBLIC_APP_URL="https://edumanage.com"
